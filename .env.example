# Celery 消息中间件（外部已有带密码的 redis-stack）
# 格式: redis://:<password>@<host>:<port>/<db>
CELERY_BROKER_URL=redis://:your-redis-password@redis-stack-host:6379/0

# 结果后端（与 broker 共用同一 redis-stack，使用不同 db）
CELERY_RESULT_BACKEND=redis://:your-redis-password@redis-stack-host:6379/1

# 可选：Flower 端口（docker-compose 中使用）
FLOWER_PORT=5555

# MySQL 业务库（try_mysql / get_one_student 任务使用）
APP_DB_HOST=192.168.1.101
APP_DB_PORT=3306
APP_DB_USER=web_user
APP_DB_PASSWORD=your-app-db-password
APP_DB_NAME=web_db

# sclog 日志库（应用日志持久化 sink 使用）
LOG_DB_HOST=192.168.1.101
LOG_DB_PORT=3306
LOG_DB_USER=log_user
LOG_DB_PASSWORD=your-log-db-password
LOG_DB_NAME=log_db

# 硅基流动（SiliconFlow）API（get_un_groups 高校信息任务使用）
API_KEY_GJLD=your-siliconflow-api-key
BASE_URL=https://api.siliconflow.cn/v1
GJLD_MODEL=Qwen/Qwen2.5-72B-Instruct
